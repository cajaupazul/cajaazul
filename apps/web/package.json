{
  "name": "campuslink",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "pages:build": "npx @opennextjs/cloudflare build && (rm -rf out-pages || true) && mkdir out-pages && cp -rv .open-next/. out-pages/ && cp -rv .open-next/assets/. out-pages/ && ( [ -f out-pages/worker.js ] && mv out-pages/worker.js out-pages/_worker.js || true ) && printf '{\"version\":1,\"include\":[\"/*\"],\"exclude\":[\"/_next/static/*\",\"/favicon.ico\",\"/logo/*\",\"/carrusel/*\",\"/icons/*\",\"/profes/*\",\"/options/*\",\"/fonts/*\",\"/*.png\",\"/*.jpg\",\"/*.jpeg\",\"/*.svg\",\"/*.webp\",\"/*.mjs\",\"/pdf.worker.min.mjs\",\"/*.ico\"]}' > out-pages/_routes.json",
    "pages:deploy": "npm run pages:build && wrangler pages deploy out-pages",
    "pages:dev": "npx @opennextjs/cloudflare && wrangler pages dev out-pages --compatibility-flag=nodejs_compat",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@floating-ui/react": "^0.27.17",
    "@mercadopago/sdk-react": "^1.0.7",
    "@opennextjs/cloudflare": "^1.16.1",
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.45.4",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.16",
    "canvas-confetti": "^1.9.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "docx-preview": "^0.3.7",
    "dotenv": "^17.2.4",
    "framer-motion": "11.15.0",
    "lucide-react": "^0.446.0",
    "mammoth": "^1.11.0",
    "next": "15.1.12",
    "open-next": "^3.0.0",
    "pdfjs-dist": "^5.4.624",
    "postcss": "^8.4.31",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-pdf": "^10.3.0",
    "tailwind-merge": "^2.5.2",
    "tailwindcss": "^3.3.0",
    "typescript": "^5.3.0",
    "xlsx": "^0.18.5"
  }
}
