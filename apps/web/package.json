{
  "name": "campuslink",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "pages:build": "npx @opennextjs/cloudflare build --non-interactive && ( [ -f .open-next/worker.js ] && mv .open-next/worker.js .open-next/_worker.js || true )",
    "pages:deploy": "npm run pages:build && wrangler pages deploy",
    "pages:dev": "npx @opennextjs/cloudflare && wrangler pages dev .open-next --compatibility-flag=nodejs_compat",
    "start": "next start",
    "lint": "next lint"
  },
  "dependencies": {
    "@mercadopago/sdk-react": "^1.0.7",
    "@opennextjs/cloudflare": "^1.16.1",
    "@radix-ui/react-avatar": "^1.1.1",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-label": "^2.1.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-slot": "^1.1.0",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.45.4",
    "canvas-confetti": "^1.9.3",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "docx-preview": "^0.3.7",
    "framer-motion": "^12.0.0-alpha.0",
    "lucide-react": "^0.446.0",
    "next": "16.1.6",
    "open-next": "^3.0.0",
    "pdfjs-dist": "^4.4.168",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-pdf": "^10.3.0",
    "tailwind-merge": "^2.5.2",
    "xlsx": "^0.18.5",
    "tailwindcss": "^3.3.0",
    "postcss": "^8.4.31",
    "autoprefixer": "^10.4.16",
    "typescript": "^5.3.0",
    "@types/node": "^20.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/canvas-confetti": "^1.9.0"
  },
  "devDependencies": {}
}